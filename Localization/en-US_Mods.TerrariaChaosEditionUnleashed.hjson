Configs: {
	ModConfigChaos: {
		DisplayName: Chaos Edition Config

		gameMode: {
			Label: Game Mode
			Tooltip: Sets the game mode to be selected
		}

		ShowEffectOverHead: {
			Label: Show Effect Over Head
			Tooltip: Whether or not the effect name should appear above player head when the effect gets activated
		}

		ShowNextEffectInChat: {
			Label: Show Next Effect In Chat
			Tooltip: Whether or not the name of the next effect and the time until its activation is shown in chat
		}

		GameModeClassic: {
			Label: Game Mode Classic
			Tooltip: Config for classic mode, how basically every chaos edition works
		}

		GameModeSurvival: {
			Label: Game Mode Survival
			Tooltip: ""
		}

		GameModeChallenge: {
			Label: Game Mode Challenge
			Tooltip: Config for challenge mode, a mode where you play a preset of effects and settings
		}

		GameModeCustom: {
			Label: Game Mode Custom
			Tooltip: Config for custom mode, customize your own chaos!
		}
	}

	ConfigClassic: {
		Tooltip: Classic Game Mode Config

		classicEffectSelection: {
			Label: Effect Selection
			Tooltip: Choose whether all effects or only the ~25 newest "featured" codes should be used.
		}
	}

	ConfigCustom: {
		Tooltip: Custom Game Mode Config

		effectCooldown: {
			Label: effect Cooldown
			Tooltip: Time until the next effect in seconds
		}

		effectCooldownRandomOffset: {
			Label: effect Cooldown Random Offset
			Tooltip: Maximum variation of the time until the next effect in seconds
		}

		effectLength: {
			Label: effect Length
			Tooltip: How long the effect is active in seconds
		}

		effectLengthRandomOffset: {
			Label: effect Length Random Offset
			Tooltip: The maximum variation in the length of the effect in seconds
		}

		CrazyGravityFxWeight: {
			Label: Crazy Gravity Weight
			Tooltip: Works like lottery. Higher number = more entries
		}

