Configs: {
	ModConfigChaos: {
		DisplayName: Chaos Edition Config

		gameMode: {
			Label: Game Mode
			Tooltip: Sets the game mode to be selected
		}

		ShowEffectOverHead: {
			Label: Show Effect Over Head
			Tooltip: Whether or not the effect name should appear above player head when the effect gets activated
		}

		ShowNextEffectInChat: {
			Label: Show Next Effect In Chat
			Tooltip: Whether or not the name of the next effect and the time until its activation is shown in chat
